{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "novel-v2-crafter": {
      "description": "V2 统一创作子引擎。基于叙事单元网络(graph)处理全部创作任务：章节写作、角色管理、世界观建设、情节设计、总纲大纲、质量检测、编辑修订",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": ".opencode/agents/novel-v2-crafter.md",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "write": "allow",
        "novel-tool": "allow"
      }
    },
    "novel-search-analysis": {
      "description": "深度诊断引擎。对 V2 项目做完整性扫描、意图对齐核验、交叉引用检测、Gap 分析、增量诊断",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": ".opencode/agents/novel-search-analysis.md",
      "permission": {
        "read": "allow",
        "novel-tool": "allow"
      }
    },
    "novel-ideation": {
      "description": "创意方案生成器。在 grill 收敛需求后，基于约束库和焦点上下文生成可选方案",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": ".opencode/agents/novel-ideation.md",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "write": "allow",
        "novel-tool": "allow"
      }
    },
    "novel-writer": {
      "description": "AI 小说创作助手 V2 — 基于叙事单元网络的纯 V2 架构",
      "mode": "primary",
      "prompt": ".opencode/agents/novel-writer.md",
      "skills": [
        "novel-v2",
        "novel-project-manager",
        "novel-env-setup",
        "book-knowledge",
        "book-to-knowledge",
        "novel-search-analysis",
        "novel-grill"
      ],
      "tools": {
        "task": true,
        "skill": true,
        "read": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "write": true
      }
    }
  }
}