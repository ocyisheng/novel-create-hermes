{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "orchestrator": {
      "description": "统一入口主 agent——意图识别、基建自处理、创作类调度、上下文隔离 subagent 扇出",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "prompt": ".opencode/agents/orchestrator.md",
      "skills": ["novel-project-manager", "novel-env-setup", "book-knowledge", "book-to-knowledge", "novel-dev-ops"],
      "tools": {
        "task": true,
        "skill": true,
        "read": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "novel-tool": true
      }
    },
    "novel-planner": {
      "description": "设计讨论主 agent——需求发现、创意构思、六维冲突设计、设计成果写入 NOTE 单元",
      "mode": "all",
      "model": "opencode/big-pickle",
      "prompt": ".opencode/agents/novel-planner.md",
      "skills": ["novel-grill", "novel-ideation", "novel-six-dimensions", "novel-dev-ops"],
      "tools": {
        "task": true,
        "skill": true,
        "read": true,
        "edit": true,
        "write": true,
        "novel-tool": true
      }
    },
    "novel-writer": {
      "description": "写作主 agent——读规划 note、物化创作全流程、编辑修改、写后处理",
      "mode": "all",
      "model": "opencode/big-pickle",
      "prompt": ".opencode/agents/novel-writer.md",
      "skills": ["novel-v2-writing", "humanizer-zh-enhanced", "novel-dev-ops"],
      "tools": {
        "task": true,
        "skill": true,
        "read": true,
        "edit": true,
        "write": true,
        "bash": true,
        "novel-tool": true
      }
    },
    "novel-lore-search": {
      "description": "跨库检索器——graph+knowledge+文件系统检索，返回结构化摘要（只读）",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": ".opencode/agents/novel-lore-search.md",
      "permission": {
        "read": "allow",
        "novel-tool": "allow"
      }
    },
    "novel-diagnose": {
      "description": "深度诊断执行器——align/cross-ref/gap/full-diagnose 全量扫描，返回报告（只读）",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": ".opencode/agents/novel-diagnose.md",
      "skills": ["novel-v2-core", "novel-search-analysis"],
      "permission": {
        "read": "allow",
        "novel-tool": "allow"
      }
    },
    "novel-book-importer": {
      "description": "书籍导入执行器——book-to-knowledge 全管道，产出知识库到 knowledge/<slug>/",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "prompt": ".opencode/agents/novel-book-importer.md",
      "skills": ["book-to-knowledge"],
      "permission": {
        "read": "allow",
        "bash": "allow",
        "write": "allow",
        "novel-tool": "allow"
      }
    }
  }
}