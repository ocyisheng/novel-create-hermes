{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "novel-writer": {
      "description": "AI 小说创作助手，覆盖创意构思、写作执行、质量把控全流程",
      "mode": "primary",
      "prompt": ".opencode/agents/novel-writer.md",
      "skills": [
        "novel-project-manager",
        "novel-env-setup",
        "novel-ideation",
        "novel-style",
        "novel-worldbuilding",
        "novel-character",
        "novel-synopsis",
        "novel-plot",
        "novel-outline",
        "novel-chapter",
        "novel-quality",
        "novel-grill",
        "novel-edit",
        "novel-export",
        "novel-search-analysis",
        "book-knowledge",
        "book-to-knowledge"
      ],
      "tools": {
        "task": true,
        "skill": true,
        "read": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "write": true
      }
    },
    "novel-crafter": {
      "description": "小说内容创作子引擎，用于世界观、角色、总纲、情节、分纲、章节写作和导出",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "write": "allow"
      }
    },
    "novel-reviewer": {
      "description": "小说质量检测子引擎，用于AI味检测、情节逻辑检测、角色一致性检查",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow"
      }
    },
    "novel-ideator": {
      "description": "小说创意构思子引擎，用于脑洞发散、风格提取",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "read": "allow"
      }
    }
  }
}
