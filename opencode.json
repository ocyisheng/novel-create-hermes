{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "novel-writer": {
      "description": "AI 小说创作助手 V2 — 基于叙事单元网络的纯 V2 架构",
      "mode": "primary",
      "prompt": ".opencode/agents/novel-writer.md",
      "skills": [
        "novel-v2",
        "novel-project-manager",
        "novel-env-setup",
        "book-knowledge",
        "book-to-knowledge",
        "novel-search-analysis",
        "novel-grill"
      ],
      "tools": {
        "task": true,
        "skill": true,
        "read": true,
        "edit": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "write": true
      }
    },
    "novel-v2-crafter": {
      "description": "V2 统一创作子引擎。基于叙事单元网络(graph)处理全部创作任务：章节写作、角色管理、世界观建设、情节设计、总纲大纲、质量检测、编辑修订",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": ".opencode/agents/novel-v2-crafter.md",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "write": "allow"
      }
    }
  }
}
